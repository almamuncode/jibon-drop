generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "postgresql"
}
model Location {
 id String @id
 name String
 bnName String?
 type String
 parentId String?
 parent Location? @relation("Hierarchy", fields: [parentId], references: [id])
 children Location[] @relation("Hierarchy")
 divisionDonors Donor[] @relation("DivisionDonors")
 districtDonors Donor[] @relation("DistrictDonors")
 localityDonors Donor[] @relation("LocalityDonors")
 areaDonors Donor[] @relation("AreaDonors")
 source String
 @@index([parentId, type])
}
model Donor {
 id String @id @default(cuid())
 publicId String @unique @default(uuid())
 userId String? @unique
 user User? @relation(fields:[userId], references:[id], onDelete:Cascade)
 phone String? @unique
 phoneVerifiedAt DateTime?
 name String @default("")
 bloodGroup String @default("")
 divisionId String?
 districtId String?
 localityId String?
 areaId String?
 division Location? @relation("DivisionDonors", fields:[divisionId], references:[id])
 district Location? @relation("DistrictDonors", fields:[districtId], references:[id])
 locality Location? @relation("LocalityDonors", fields:[localityId], references:[id])
 area Location? @relation("AreaDonors", fields:[areaId], references:[id])
 fallbackArea String?
 imageUrl String?
 available Boolean @default(true)
 visible Boolean @default(false)
 moderationBlocked Boolean @default(false)
 consentAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt

 donations Donation[]
 donationCount Int @default(0)
 lastDonation DateTime? @db.Date
 @@index([bloodGroup, visible, divisionId, districtId, localityId, areaId])
}
model User {
 role String @default("USER")
 suspended Boolean @default(false)
 id String @id
 name String
 email String @unique
 emailVerified Boolean @default(false)
 image String?
 username String? @unique
 displayUsername String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 sessions Session[]
 accounts Account[]
 donor Donor?
}
model Session {
 id String @id
 token String @unique
 userId String
 user User @relation(fields:[userId], references:[id], onDelete:Cascade)
 expiresAt DateTime
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 ipAddress String?
 userAgent String?
 @@index([userId])
}
model Account {
 id String @id
 accountId String
 providerId String
 userId String
 user User @relation(fields:[userId], references:[id], onDelete:Cascade)
 accessToken String?
 refreshToken String?
 idToken String?
 accessTokenExpiresAt DateTime?
 refreshTokenExpiresAt DateTime?
 scope String?
 password String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([userId])
 @@unique([providerId,accountId])
}
model Verification {
 id String @id
 identifier String
 value String
 expiresAt DateTime
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([identifier])
}
model Donation {
 id String @id @default(uuid())
 donorId String
 donor Donor @relation(fields: [donorId], references: [id], onDelete: Cascade)
 date DateTime @db.Date
 hospital String?
 note String?
 submissionId String @unique
 @@index([donorId, date])
}
model RateLimit {
 key String @id
 count Int
 resetAt DateTime
}
model BlobCleanup {
 id String @id @default(cuid())
 url String @unique
 createdAt DateTime @default(now())
}

model AdminAudit {
 id String @id @default(cuid())
 actorId String
 targetId String
 action String
 reason String
 createdAt DateTime @default(now())
 @@index([createdAt])
}
