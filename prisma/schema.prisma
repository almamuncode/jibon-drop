generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "postgresql"
}
model Location {
 id String @id
 name String
 bnName String?
 type String
 parentId String?
 parent Location? @relation("Hierarchy", fields: [parentId], references: [id])
 children Location[] @relation("Hierarchy")
 divisionDonors Donor[] @relation("DivisionDonors")
 districtDonors Donor[] @relation("DistrictDonors")
 localityDonors Donor[] @relation("LocalityDonors")
 areaDonors Donor[] @relation("AreaDonors")
 source String
 @@index([parentId, type])
}
model Donor {
 id String @id @default(cuid())
 publicId String @unique @default(uuid())
 userId String? @unique
 user User? @relation(fields:[userId], references:[id], onDelete:Cascade)
 phone String? @unique
 phoneVerifiedAt DateTime?
 name String @default("")
 bloodGroup String @default("")
 dateOfBirth DateTime? @db.Date
 weightKg Float?
 divisionId String?
 districtId String?
 localityId String?
 areaId String?
 division Location? @relation("DivisionDonors", fields:[divisionId], references:[id])
 district Location? @relation("DistrictDonors", fields:[districtId], references:[id])
 locality Location? @relation("LocalityDonors", fields:[localityId], references:[id])
 area Location? @relation("AreaDonors", fields:[areaId], references:[id])
 fallbackArea String?
 imageUrl String?
 available Boolean @default(true)
 visible Boolean @default(false)
 sharePhone Boolean @default(true)
 phonePublic Boolean @default(false)
 facebook String?
 moderationBlocked Boolean @default(false)
 consentAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt

 donations Donation[]
 contactRequests ContactRequest[]
 donationCount Int @default(0)
 lastDonation DateTime? @db.Date
 @@index([bloodGroup, visible, divisionId, districtId, localityId, areaId])
}
model User {
 role String @default("USER")
 suspended Boolean @default(false)
 id String @id
 name String
 email String @unique
 emailVerified Boolean @default(false)
 image String?
 username String? @unique
 displayUsername String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 sessions Session[]
 accounts Account[]
 donor Donor?
 contactRequests ContactRequest[] @relation("RequestedContacts")
 abuseReports AbuseReport[] @relation("ReportedAbuse")
 reportsAgainst AbuseReport[] @relation("AbuseTargets")
 notifications Notification[]
}
model Session {
 id String @id
 token String @unique
 userId String
 user User @relation(fields:[userId], references:[id], onDelete:Cascade)
 expiresAt DateTime
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 ipAddress String?
 userAgent String?
 @@index([userId])
}
model Account {
 id String @id
 accountId String
 providerId String
 userId String
 user User @relation(fields:[userId], references:[id], onDelete:Cascade)
 accessToken String?
 refreshToken String?
 idToken String?
 accessTokenExpiresAt DateTime?
 refreshTokenExpiresAt DateTime?
 scope String?
 password String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([userId])
 @@unique([providerId,accountId])
}
model Verification {
 id String @id
 identifier String
 value String
 expiresAt DateTime
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([identifier])
}
model Donation {
 id String @id @default(uuid())
 donorId String
 donor Donor @relation(fields: [donorId], references: [id], onDelete: Cascade)
 date DateTime @db.Date
 hospital String?
 note String?
 submissionId String @unique
 @@index([donorId, date])
}
model RateLimit {
 key String @id
 count Int
 resetAt DateTime
}
model BlobCleanup {
 id String @id @default(cuid())
 url String @unique
 createdAt DateTime @default(now())
}

model AdminAudit {
 id String @id @default(cuid())
 actorId String
 targetId String
 action String
 reason String
 createdAt DateTime @default(now())
 @@index([createdAt])
}

model ContactRequest {
 id String @id @default(cuid())
 donorId String
 donor Donor @relation(fields: [donorId], references: [id], onDelete: Cascade)
 requesterId String
 requester User @relation("RequestedContacts", fields: [requesterId], references: [id], onDelete: Cascade)
 message String
 status String @default("PENDING")
 phoneHash String?
 expiresAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 reports AbuseReport[]
 notification Notification?
 @@unique([donorId, requesterId])
 @@index([donorId, status, createdAt])
 @@index([requesterId, createdAt])
}

model AbuseReport {
 id String @id @default(cuid())
 contactRequestId String?
 contactRequest ContactRequest? @relation(fields: [contactRequestId], references: [id], onDelete: SetNull)
 reporterId String
 reporter User @relation("ReportedAbuse", fields: [reporterId], references: [id], onDelete: Cascade)
 targetUserId String
 targetUser User @relation("AbuseTargets", fields: [targetUserId], references: [id], onDelete: Cascade)
 reason String
 details String
 status String @default("OPEN")
 createdAt DateTime @default(now())
 resolvedAt DateTime?
 @@unique([reporterId, contactRequestId])
 @@index([status, createdAt])
}

model Notification {
 id String @id @default(cuid())
 userId String
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 contactRequestId String @unique
 contactRequest ContactRequest @relation(fields: [contactRequestId], references: [id], onDelete: Cascade)
 type String @default("CONTACT_REQUEST")
 readAt DateTime?
 emailStatus String @default("PENDING")
 emailAttempts Int @default(0)
 emailLockedUntil DateTime?
 emailNextAttemptAt DateTime?
 emailSentAt DateTime?
 emailError String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([userId, readAt])
 @@index([emailStatus, emailNextAttemptAt])
}
