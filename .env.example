DATABASE_URL=postgresql://USER:PASSWORD@HOST/jibondrop?sslmode=require
AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BLOB_READ_WRITE_TOKEN=
# If your public store uses the JIBON_PUBLIC prefix, use this instead:
JIBON_PUBLIC_READ_WRITE_TOKEN=

# Email changes: Resend API key and a sender on your verified domain.
RESEND_API_KEY=
EMAIL_FROM=
# Optional fixed origin for protected donor mutations
APP_ORIGIN=
# Donor notification retries: Vercel Cron sends this as a Bearer token (16+ random characters).
CRON_SECRET=
